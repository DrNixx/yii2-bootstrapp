{
    "name": "drnixx/yii2-bootstrapp",
    "description": "Bootstrap5 & Revox.Io Pages widgets for Yii2",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Nick Panteleeff",
            "email": "drnix@chess-online.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=7.4",

        "yiisoft/yii2": "~2.0.45",
        "yiisoft/yii2-bootstrap5": "^2.0",

        "drnixx/yii2-onix": "^1.0",
        "drnixx/yii2-pages-asset": "^3.0"
    },
    "require-dev": {
        "yiisoft/yii2-faker": "~2.0.0",

        "phpunit/phpunit": "^10.0",
        "codeception/codeception": "^5.0.0 || ^4.0",
        "codeception/lib-innerbrowser": "^4.0 || ^3.0 || ^1.1",
        "codeception/module-asserts": "^3.0 || ^1.1",
        "codeception/module-yii2": "^1.1",
        "codeception/module-db": "^3.1",
        "codeception/module-filesystem": "^3.0 || ^2.0 || ^1.1",
        "codeception/verify": "^3.0 || ^2.2",
        "symfony/browser-kit": "^6.0 || >=2.7 <=4.2.4"
    },
    "autoload": {
        "psr-4": {
            "onix\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}
